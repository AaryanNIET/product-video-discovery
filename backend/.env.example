# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://localhost:27017/product-video-discovery

# Provider mode: "mock" (default, no external creds needed) or "live"
PROVIDER_MODE=mock

# OpenAI (multimodal) - used for product image analysis & visual verification.
# If absent, the system falls back to a deterministic heuristic scorer so the
# MVP still runs end-to-end in mock mode.
OPENAI_API_KEY=

# Instagram (Meta Graph API) - required only when PROVIDER_MODE=live
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_GRAPH_API_VERSION=v20.0

# Meta Ad Library API - required only when PROVIDER_MODE=live
META_AD_LIBRARY_ACCESS_TOKEN=
META_AD_LIBRARY_API_VERSION=v20.0

# Ranking weights (must sum to 1.0)
RANK_WEIGHT_TEXT=0.30
RANK_WEIGHT_VISUAL=0.50
RANK_WEIGHT_METADATA=0.20

# Visual verification confidence threshold (0-100) below which a candidate is rejected
VERIFICATION_MIN_CONFIDENCE=55
