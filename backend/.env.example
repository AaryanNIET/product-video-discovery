# ---------------------------------------------------------------
# Copy to backend/.env and fill in the two keys marked REQUIRED.
# Never commit backend/.env (it is git-ignored).
# ---------------------------------------------------------------

# --- Server ---
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173

# --- Database (search history, seen-video index, caches, shortlist) ---
# Local/Docker: mongodb://localhost:27017/product-video-discovery
# Atlas: use the "standard connection string" (mongodb://host1,host2,host3/...) if
# your network cannot resolve mongodb+srv:// DNS records.
MONGODB_URI=mongodb://localhost:27017/product-video-discovery

# --- Video sources ---
# live = real data scraped through Apify; mock = generated data for offline development
PROVIDER_MODE=live
# REQUIRED for live mode. https://console.apify.com/settings/integrations
APIFY_TOKEN=
# Actors used per source (change only if you switch scrapers)
APIFY_INSTAGRAM_ACTOR=apify~instagram-hashtag-scraper
APIFY_META_ADS_ACTOR=apify~facebook-ads-scraper
APIFY_TIKTOK_ACTOR=clockworks~tiktok-scraper
APIFY_RUN_TIMEOUT_SEC=240
# Ad Library country filter (ALL = every country)
META_ADS_COUNTRY=ALL
# Allow the optional TikTok source (users still switch it on per search)
ENABLE_TIKTOK=true

# --- Image-analysis brain ---
# REQUIRED for real visual matching. https://aistudio.google.com/apikey
# Without it, scores fall back to caption text only (clearly labelled in the UI).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Parallel Gemini requests and thumbnails per request (lower these on the free tier if you see 429s)
GEMINI_CONCURRENCY=3
GEMINI_BATCH_SIZE=6

# --- Matching rules ---
# Videos scoring below this (0-100) are marked "below threshold" and don't count toward the minimum
MATCH_THRESHOLD=65
PER_SOURCE_MINIMUM=20
# Search rounds per source when results fall short (each round widens the terms / goes deeper)
MAX_SEARCH_ROUNDS=3
# Cost guard: max videos checked by the vision model per source per search
MAX_VISION_PER_SOURCE=90

# --- Jobs ---
MAX_CONCURRENT_JOBS=2
